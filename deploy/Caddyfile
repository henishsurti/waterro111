# Caddy obtains and renews the HTTPS certificate for $DOMAIN automatically.
# Requirements: the domain's DNS A record points at this server, and ports 80 and 443 are open.
{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy app:8799
}
