# Copy to .env and fill in. Never commit .env.

# Your public address (DNS A record must point at this server).
DOMAIN=app.example.com

# First admin account, created only when the database is brand new.
# Use a strong password (at least 10 characters). Change it again from inside the app if you like.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Backups: one every N hours, keeping the newest N files.
BACKUP_EVERY_HOURS=24
BACKUP_KEEP=30
